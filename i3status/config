# Copied from /etc/i3status.conf; removed the "ipv6" module (its address can embed the MAC)
# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        # lets formats use <span color=...> to color parts of a module
        markup = "pango"
        # explicit, because i3status runs inside scripts/status.sh and can't auto-detect i3bar
        output_format = "i3bar"
        interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
# order += "battery all"
order += "disk /"
order += "cpu_usage"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "wlan0: (%quality at %essid) %ip"
        format_down = "wlan0: down"
}

ethernet _first_ {
        format_up = "eno1: %ip (%speed)"
        format_down = "eno1: down"
}

# battery all {
#         format = "%status %percentage %remaining"
# }

# disk "/" {
#         format = "%avail"
# }

cpu_usage {
        format = "CPU %usage"
}

memory {
        format = "<span color='#f38ba8'>%used</span>   <span color='#8BF3D6'>%available</span>"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "<span color='#EA2BED'>%Y-%m-%d</span>   <span color='#2EED2B'>%H:%M:%S</span>"
}
